# ─────────────────────────────────────────────────────────────
#  RPG Watcher – example configuration
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ── Whisper transcription ─────────────────────────────────────
# Model size: tiny | base | small | medium | large  (default: base)
# Larger models are more accurate but slower and use more RAM.
WHISPER_MODEL=base

# Optional: full path to the whisper.cpp main binary.
# If set and the file exists, whisper.cpp is used instead of the Python
# openai-whisper package.  The model file must be at
#   <directory containing WHISPER_CPP_PATH>/models/ggml-<WHISPER_MODEL>.bin
# Leave empty to use the Python package.
WHISPER_CPP_PATH=

# ── Ollama ────────────────────────────────────────────────────
# Base URL of your local Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for summarisation (default: mistral)
# Run `ollama pull <model>` to download it first.
OLLAMA_MODEL=mistral

# ── Obsidian vault ────────────────────────────────────────────
# Absolute path to the root of your Obsidian vault
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Sub-folder inside the vault where session notes will be created
# (created automatically if it does not exist)
OBSIDIAN_NOTES_FOLDER=Session Notes

# ── Recording ─────────────────────────────────────────────────
# Directory for temporary WAV recordings (created automatically)
RECORDINGS_DIR=/tmp/rpgwatcher_recordings

# ── Database ──────────────────────────────────────────────────
# SQLite database file path (created automatically)
RPGWATCHER_DB=rpgwatcher.db

# ── Reliability (v0.3+) ───────────────────────────────────────
# Maximum Ollama retry attempts on failure (default: 3)
OLLAMA_MAX_RETRIES=3

# Base delay in seconds between retries with exponential back-off (default: 2.0)
OLLAMA_RETRY_DELAY_S=2.0

# ── Access control (v0.7+) ───────────────────────────────────
# Comma-separated Discord Role IDs allowed to use /watch and /unwatch.
# Leave empty to allow all users.
ALLOWED_ROLE_IDS=

# Minimum free disk space in MB before /watch is allowed (default: 500)
MIN_FREE_DISK_MB=500

# ── Audio preprocessing (v0.6+) ───────────────────────────────
# RMS silence threshold in dBFS for trim_silence (default: -40)
SILENCE_THRESHOLD_DB=-40

# Sample rate used by Discord voice (do not change unless you know why)
RECORDING_SAMPLE_RATE=48000

# ── Logging (v0.3+) ───────────────────────────────────────────
# Set to 'json' for structured JSON logs (useful in containers/Docker)
# Set to 'text' (default) for human-readable logs
LOG_FORMAT=text
